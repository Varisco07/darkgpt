# Configurazione DarkGPT — copiare in `.env` e compilare.
# `.env` NON deve essere committato: contiene i segreti.

# --- Server ---------------------------------------------------------------
DARKGPT_HOST=127.0.0.1
DARKGPT_PORT=8000
DARKGPT_DEBUG=false
# Origini autorizzate per il frontend (separati da virgola).
DARKGPT_CORS_ORIGINS=http://localhost:3000

# --- Storage --------------------------------------------------------------
# SQLite (predefinito). Per PostgreSQL:
# DARKGPT_DATABASE_URL=postgresql+psycopg://utente:password@localhost/darkgpt
DARKGPT_DATABASE_URL=sqlite:///./darkgpt.db
DARKGPT_SQL_ECHO=false

# --- Provider LLM (interfaccia OpenAI-compatible) -------------------------
# Endpoint: OpenAI, Ollama (http://localhost:11434/v1), LM Studio, vLLM...
# Se DARKGPT_LLM_BASE_URL e' vuota, la piattaforma resta operativa ma la
# chat AI risponde con il provider di fallback dichiarato (simulato).
DARKGPT_LLM_BASE_URL=
DARKGPT_LLM_API_KEY=
DARKGPT_LLM_MODEL=gpt-4o-mini
DARKGPT_LLM_TEMPERATURE=0.2
DARKGPT_LLM_MAX_TOKENS=4096
DARKGPT_LLM_TIMEOUT=60
DARKGPT_LLM_MAX_RETRIES=2
DARKGPT_LLM_CONTEXT_MAX_CHARS=24000

# --- Limiti operativi -----------------------------------------------------
DARKGPT_HTTP_MAX_REQUESTS_PER_RUN=50
DARKGPT_HTTP_TIMEOUT=15
DARKGPT_TOOL_TIMEOUT_DEFAULT=120
DARKGPT_TOOL_MAX_OUTPUT_BYTES=2000000
DARKGPT_SCAN_MAX_FILES=2000
DARKGPT_SCAN_MAX_FILE_BYTES=5000000

# --- Percorsi -------------------------------------------------------------
# Radice dei bersagli di laboratorio. I tool non possono uscirne.
DARKGPT_LAB_ROOT=lab
